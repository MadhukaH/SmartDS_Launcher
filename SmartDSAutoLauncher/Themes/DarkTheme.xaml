<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0F1117" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#161922" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#1C202C" />
    <SolidColorBrush x:Key="CardBackgroundHoverBrush" Color="#232838" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2A3042" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#13161F" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#2E354B" />
    <SolidColorBrush x:Key="InputFocusedBorderBrush" Color="#3B82F6" />

    <!-- Foregrounds -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B" />
    <SolidColorBrush x:Key="TextInverseBrush" Color="#FFFFFF" />

    <!-- Brand / Accent Colors -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#1E3A8A" />

    <!-- Status Colors -->
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#10B981" />
    <SolidColorBrush x:Key="StatusSuccessBgBrush" Color="#064E3B" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="StatusWarningBgBrush" Color="#78350F" />
    <SolidColorBrush x:Key="StatusDangerBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="StatusDangerBgBrush" Color="#7F1D1D" />
    <SolidColorBrush x:Key="StatusStoppedBrush" Color="#64748B" />
    <SolidColorBrush x:Key="StatusStoppedBgBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="StatusInfoBrush" Color="#0EA5E9" />
    <SolidColorBrush x:Key="StatusInfoBgBrush" Color="#082F49" />

    <!-- Dividers & Overlays -->
    <SolidColorBrush x:Key="DividerBrush" Color="#22283A" />
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#AA0B0D13" />

    <!-- Console / Log Viewer -->
    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#0A0C10" />
    <SolidColorBrush x:Key="TerminalTextBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="TerminalBorderBrush" Color="#1E2433" />

</ResourceDictionary>

