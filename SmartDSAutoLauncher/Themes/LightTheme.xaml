<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Backgrounds -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBackgroundHoverBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#CBD5E1" />
    <SolidColorBrush x:Key="InputFocusedBorderBrush" Color="#2563EB" />

    <!-- Foregrounds -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />
    <SolidColorBrush x:Key="TextInverseBrush" Color="#FFFFFF" />

    <!-- Brand / Accent Colors -->
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="#DBEAFE" />

    <!-- Status Colors -->
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="StatusSuccessBgBrush" Color="#DCFCE7" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#D97706" />
    <SolidColorBrush x:Key="StatusWarningBgBrush" Color="#FEF3C7" />
    <SolidColorBrush x:Key="StatusDangerBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="StatusDangerBgBrush" Color="#FEE2E2" />
    <SolidColorBrush x:Key="StatusStoppedBrush" Color="#64748B" />
    <SolidColorBrush x:Key="StatusStoppedBgBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="StatusInfoBrush" Color="#0284C7" />
    <SolidColorBrush x:Key="StatusInfoBgBrush" Color="#E0F2FE" />

    <!-- Dividers & Overlays -->
    <SolidColorBrush x:Key="DividerBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#66000000" />

    <!-- Console / Log Viewer -->
    <SolidColorBrush x:Key="TerminalBackgroundBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TerminalTextBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="TerminalBorderBrush" Color="#1E293B" />

</ResourceDictionary>

