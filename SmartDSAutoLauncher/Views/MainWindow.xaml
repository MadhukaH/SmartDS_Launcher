<Window x:Class="SmartDSAutoLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SmartDSAutoLauncher.ViewModels"
        mc:Ignorable="d"
        Title="SmartDS Auto Launcher"
        Height="780" Width="1180"
        MinHeight="650" MinWidth="950"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <Border Grid.Row="0" Padding="20,24,20,20" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Logo Icon -->
                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                Background="{DynamicResource AccentBrush}" Margin="0,0,12,0">
                            <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="SmartDS" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            <TextBlock Text="Auto Launcher" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Navigation Links -->
                <StackPanel Grid.Row="1" Margin="12,18,12,0">
                    <RadioButton Content="📊   Dashboard"
                                 Style="{DynamicResource NavButton}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool}, ConverterParameter=Dashboard}"
                                 Command="{Binding NavigateToDashboardCommand}" />

                    <RadioButton Content="⚡   Startup Sequence"
                                 Style="{DynamicResource NavButton}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool}, ConverterParameter=Sequence}"
                                 Command="{Binding NavigateToSequenceCommand}" />

                    <RadioButton Content="📋   Execution Logs"
                                 Style="{DynamicResource NavButton}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool}, ConverterParameter=Logs}"
                                 Command="{Binding NavigateToLogsCommand}" />

                    <RadioButton Content="⚙️   Settings"
                                 Style="{DynamicResource NavButton}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool}, ConverterParameter=Settings}"
                                 Command="{Binding NavigateToSettingsCommand}" />

                    <RadioButton Content="ℹ️   About"
                                 Style="{DynamicResource NavButton}"
                                 IsChecked="{Binding CurrentPage, Converter={StaticResource EnumToBool}, ConverterParameter=About}"
                                 Command="{Binding NavigateToAboutCommand}" />
                </StackPanel>

                <!-- Bottom Status Footer -->
                <Border Grid.Row="2" Padding="16,14" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse Width="8" Height="8" Margin="0,0,8,0"
                                     Fill="{Binding RunningServices, Converter={StaticResource StatusToColor}}" />
                            <TextBlock Text="Stack Status" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Host Area -->
        <Border Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}">
            <ContentControl x:Name="MainContentHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Border>
    </Grid>
</Window>
