<UserControl x:Class="SmartDSAutoLauncher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SmartDSAutoLauncher.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,28">

            <!-- Header -->
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Application Settings" Style="{DynamicResource TitleText}" />
                    <TextBlock Text="Configure Windows auto-start, system tray behavior, network ports, and logging"
                               Style="{DynamicResource SubTitleText}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Reset Defaults" Style="{DynamicResource SecondaryButton}"
                            Command="{Binding ResetCommand}" Margin="0,0,10,0" />
                    <Button Content="💾 Save Settings" Style="{DynamicResource PrimaryButton}"
                            Command="{Binding SaveCommand}" Width="140" Height="38" />
                </StackPanel>
            </Grid>

            <!-- Windows Startup Card -->
            <Border Style="{DynamicResource ModernCard}" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="🚀" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Windows Startup Integration" Style="{DynamicResource SectionHeading}" />
                            <TextBlock Text="Automatically start pgAdmin, backend, and frontend when logging in"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Windows Startup Toggle -->
                    <Border Background="{DynamicResource InputBackgroundBrush}" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Start automatically when I log in to Windows" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" />
                                <TextBlock Text="Registers per-user startup entry in HKCU\Run. No administrator privileges required."
                                           Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,2,0,0" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" IsChecked="{Binding StartWithWindows}" Style="{DynamicResource ModernCheckBox}" />
                        </Grid>
                    </Border>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Startup Delay -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Initial Windows Startup Delay (seconds)" Style="{DynamicResource LabelText}" />
                            <TextBox Text="{Binding StartupDelay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" />
                            <TextBlock Text="Gives system services and network time to initialize before launching stack"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- Auto start on launch -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <CheckBox Content="Launch all services automatically on app start"
                                      IsChecked="{Binding AutoStartOnLaunch}" Style="{DynamicResource ModernCheckBox}" Margin="0,0,0,8" />
                            <CheckBox Content="Start minimized to notification area"
                                      IsChecked="{Binding StartMinimized}" Style="{DynamicResource ModernCheckBox}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Window & Tray Behavior Card -->
            <Border Style="{DynamicResource ModernCard}" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="🔔" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="System Tray &amp; Notification Preferences" Style="{DynamicResource SectionHeading}" />
                            <TextBlock Text="Control background execution and desktop notifications"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <CheckBox Content="Minimize to notification area (system tray) when closed"
                                      IsChecked="{Binding MinimizeToTray}" Style="{DynamicResource ModernCheckBox}" Margin="0,0,0,12" />
                            <CheckBox Content="Show Windows notifications on startup success or error"
                                      IsChecked="{Binding ShowNotifications}" Style="{DynamicResource ModernCheckBox}" Margin="0,0,0,12" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <CheckBox Content="Prompt for confirmation before closing or shutting down"
                                      IsChecked="{Binding ConfirmOnShutdown}" Style="{DynamicResource ModernCheckBox}" Margin="0,0,0,12" />
                            <CheckBox Content="Prompt for confirmation before launching services"
                                      IsChecked="{Binding ConfirmOnStartup}" Style="{DynamicResource ModernCheckBox}" Margin="0,0,0,12" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Service Network & Port Configuration Card -->
            <Border Style="{DynamicResource ModernCard}" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="🌐" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Network &amp; Port Settings" Style="{DynamicResource SectionHeading}" />
                            <TextBlock Text="Configure host addresses and ports for backend and frontend services"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Backend Host" Style="{DynamicResource LabelText}" />
                            <TextBox Text="{Binding BackendHost, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Backend Port" Style="{DynamicResource LabelText}" />
                            <TextBox Text="{Binding BackendPort, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Frontend Host" Style="{DynamicResource LabelText}" />
                            <TextBox Text="{Binding FrontendHost, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" />
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Frontend Port" Style="{DynamicResource LabelText}" />
                            <TextBox Text="{Binding FrontendPort, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Logging & Storage Card -->
            <Border Style="{DynamicResource ModernCard}" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="📁" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Logging &amp; File Storage" Style="{DynamicResource SectionHeading}" />
                            <TextBlock Text="Specify directory for stdout/stderr logs and configure rotation policy"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="12" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="Central Logs Directory" Style="{DynamicResource LabelText}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding LogDirectory, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" />
                            <Button Grid.Column="1" Content="Browse..." Style="{DynamicResource SecondaryButton}"
                                    Command="{Binding BrowseLogDirCommand}" Margin="8,0,0,0" Width="80" />
                        </Grid>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <CheckBox Content="Enable automated log file rotation"
                                      IsChecked="{Binding EnableLogRotation}" Style="{DynamicResource ModernCheckBox}" Margin="0,0,0,6" />
                            <TextBlock Text="Rotates logs when maximum size threshold is reached"
                                       Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Max Log File Size (MB)" Style="{DynamicResource LabelText}" />
                            <TextBox Text="{Binding MaxLogSizeMB, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Theme Card -->
            <Border Style="{DynamicResource ModernCard}">
                <StackPanel>
                    <TextBlock Text="Appearance Theme" Style="{DynamicResource SectionHeading}" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <RadioButton Content="🌙 Dark Theme (Recommended)"
                                     IsChecked="{Binding Theme, Converter={StaticResource EnumToBool}, ConverterParameter=Dark}"
                                     Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,24,0" />
                        <RadioButton Content="☀️ Light Theme"
                                     IsChecked="{Binding Theme, Converter={StaticResource EnumToBool}, ConverterParameter=Light}"
                                     Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Status Banner -->
            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource StatusSuccessBrush}"
                       FontSize="13" Margin="0,16,0,0" HorizontalAlignment="Center" />

        </StackPanel>
    </ScrollViewer>
</UserControl>

