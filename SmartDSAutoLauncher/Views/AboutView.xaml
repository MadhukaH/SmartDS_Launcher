<UserControl x:Class="SmartDSAutoLauncher.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SmartDSAutoLauncher.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,28">

            <!-- App Branding Header -->
            <Border Style="{DynamicResource ModernCard}" Margin="0,0,0,20" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- App Icon / Badge -->
                    <Border Grid.Column="0" Width="64" Height="64" CornerRadius="16"
                            Background="{DynamicResource AccentGlowBrush}"
                            BorderBrush="{DynamicResource AccentLightBrush}" BorderThickness="1.5"
                            Margin="0,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="🚀" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="SmartDS Auto Launcher" FontSize="22" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,12,0" />
                            <Border CornerRadius="6" Padding="8,2" Background="{DynamicResource AccentBrush}">
                                <TextBlock Text="v1.0.0 (Production)" FontSize="11" FontWeight="SemiBold" Foreground="#FFFFFF" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Reliable automated startup manager for PostgreSQL pgAdmin 4, Node.js Backend, and Next.js Frontend."
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,6,0,0" />
                        <TextBlock Text="Built with C#, WPF, and .NET 8 (x64) • Designed for Windows 10 &amp; 11"
                                   Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Architecture & Startup Mode Explanation -->
            <Border Style="{DynamicResource ModernCard}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="ℹ️ User-Login Startup vs. Boot-Time Windows Services" Style="{DynamicResource SectionHeading}" Margin="0,0,0,10" />
                    <TextBlock Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" LineHeight="20">
                        SmartDS Auto Launcher runs in the <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">interactive Windows user session</Run> triggered upon user login.
                        <LineBreak /><LineBreak />
                        • <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">Why user-login startup?</Run> GUI applications like <Run FontStyle="Italic">pgAdmin 4</Run> require an interactive desktop session to display their window. Standard boot-time Windows Services run in Session 0 (isolated from the desktop) where interactive windows cannot be shown.
                        <LineBreak />
                        • <Run FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}">Automatic Launch on Boot:</Run> When the computer powers on and the user logs in, Windows launches this application via HKCU\Run. All configured services start sequentially with health checks, readiness delays, and automatic retries.
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- Environment Diagnostics & Paths -->
            <Border Style="{DynamicResource ModernCard}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="System Diagnostics &amp; Paths" Style="{DynamicResource SectionHeading}" Margin="0,0,0,14" />

                    <!-- Node.js Path -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Node.js Executable:" Style="{DynamicResource LabelText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="node.exe (System PATH)"
                                   Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" />
                    </Grid>

                    <!-- PostgreSQL / pgAdmin Path -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="pgAdmin 4 Shortcut:" Style="{DynamicResource LabelText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="C:\ProgramData\Microsoft\Windows\Start Menu\Programs\PostgreSQL 18\pgAdmin 4.lnk"
                                   Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Backend Root -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Backend Working Dir:" Style="{DynamicResource LabelText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="C:\SmartDS\backend (dist\server.js)"
                                   Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Frontend Root -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Frontend Working Dir:" Style="{DynamicResource LabelText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="C:\SmartDS\frontend (.next\standalone\server.js)"
                                   Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Settings Storage -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Configuration Path:" Style="{DynamicResource LabelText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="%LocalAppData%\SmartDSAutoLauncher\settings.json"
                                   Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" />
                    </Grid>

                    <!-- Logs Directory -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Output Logs:" Style="{DynamicResource LabelText}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="C:\SmartDS\logs\backend.log &amp; frontend.log"
                                   Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Troubleshooting & Quick Actions -->
            <Border Style="{DynamicResource ModernCard}">
                <StackPanel>
                    <TextBlock Text="Troubleshooting &amp; Support" Style="{DynamicResource SectionHeading}" Margin="0,0,0,10" />
                    <TextBlock Text="If a service fails to start or ports are blocked, check that no conflicting instance is running, verify that PostgreSQL 18 service is running in services.msc, and ensure node dependencies are installed under C:\SmartDS."
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal">
                        <Button Content="📁 Open Logs Directory" Style="{DynamicResource SecondaryButton}"
                                Command="{Binding OpenLogFolderCommand}" Margin="0,0,10,0" />
                        <Button Content="📋 Copy Last Error" Style="{DynamicResource SecondaryButton}"
                                Command="{Binding CopyLastErrorCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
